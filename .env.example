# Fully local default: Ollama serves neural embeddings and Qwen generation.
BIORAG_EMBEDDING_PROVIDER=ollama
BIORAG_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
BIORAG_EMBEDDING_MODEL=gemini-embedding-2
BIORAG_GENERATION_PROVIDER=ollama
BIORAG_GENERATION_MODEL=qwen2:0.5b-instruct
OLLAMA_BASE_URL=http://localhost:11434
BIORAG_REQUEST_TIMEOUT=60
GEMINI_API_KEY=
BIORAG_TOP_K=5
BIORAG_DATA_DIR=data
BIORAG_OCR_LANG=eng
BIORAG_EXTRACTION_ENGINES=docling,markitdown,pymupdf
BIORAG_INDEX_DIR=data/index
BIORAG_MIN_RELEVANCE=0.20
BIORAG_MAX_RETRIEVAL_ATTEMPTS=2
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
